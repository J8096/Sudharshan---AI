# ─── REQUIRED ───────────────────────────────────────────────
GROQ_API_KEY=

# ─── DATABASE ───────────────────────────────────────────────
# Leave blank to use in-memory storage (data resets on restart)
MONGODB_URI=

# ─── AUTH ───────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# ─── APP ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── FRONTEND (set to your Vercel URL) ──────────────────────
FRONTEND_URL=https://your-app.vercel.app
